# 复制为 .env 并填入真实 key（.env 已被 .gitignore 排除，切勿提交）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# 单模块输出上限；应使用当前 DeepSeek 模型允许的值，不要设置为 384000 这类超大值。
# DEEPSEEK_MAX_OUTPUT_TOKENS=8192
# 送入模型前的上下文字符预算，默认 60000。
# EXTRACT_MAX_CONTEXT_CHARS=60000

# OCR（扫描版简历 / 纯图片 PDF 需要，本机需先安装 Tesseract 与 Poppler）
# macOS: brew install tesseract tesseract-lang poppler
# OCR_LANGUAGES=chi_sim+eng
# OCR_DPI=300
# TESSERACT_CMD=tesseract

# 网页搜索（核验奖项/经费/职位/机构等非论文声明）
# 默认使用 Bing HTML 免费后端（无需 key）；以后换付费 key 再切 provider。
# WEB_SEARCH_PROVIDER=bing
# WEB_SEARCH_BASE_URL=https://cn.bing.com/search
# 公开来源核验并发数；避免逐条串行导致接口长时间无响应。
# VERIFY_MAX_WORKERS=8

# 大文件分片上传与异步分析
# MAX_FILE_BYTES=104857600
# CHUNK_SESSION_TTL_SECONDS=3600
# MAX_CHUNK_SESSIONS=32
# ANALYSIS_MAX_WORKERS=4
