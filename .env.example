# 复制为 .env 并填入真实 key（.env 已被 .gitignore 排除，切勿提交）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# 单模块输出上限；应使用当前 DeepSeek 模型允许的值，不要设置为 384000 这类超大值。
# DEEPSEEK_MAX_OUTPUT_TOKENS=8192
# 送入模型前的上下文字符预算，默认 60000。
# EXTRACT_MAX_CONTEXT_CHARS=60000

# OCR（扫描版简历 / 纯图片 PDF 需要，本机需先安装 Tesseract 与 Poppler）
# macOS: brew install tesseract tesseract-lang poppler
# OCR_LANGUAGES=chi_sim+eng
# OCR_DPI=300
# TESSERACT_CMD=tesseract

# 网页搜索（核验奖项/经费/职位/机构等非论文声明）
# 默认使用 Bing HTML 免费后端（无需 key）；以后换付费 key 再切 provider。
# WEB_SEARCH_PROVIDER=bing
# WEB_SEARCH_BASE_URL=https://cn.bing.com/search
# OpenAlex 礼貌池邮箱：填真实邮箱进入 polite pool（配额更高）；留空则用公共池。
# OPENALEX_MAILTO=your-real-email@example.com
# 公开来源核验并发数；默认 8，建议降到 2 以避免瞬时打爆 OpenAlex 限流。
# VERIFY_MAX_WORKERS=2

# 大文件分片上传与异步分析
# MAX_FILE_BYTES=104857600
# CHUNK_SESSION_TTL_SECONDS=3600
# MAX_CHUNK_SESSIONS=32
# ANALYSIS_MAX_WORKERS=4

# Interview video workflow
# INTERVIEW_DATA_DIR=./.cache/interview
# INTERVIEW_MAX_VIDEO_BYTES=524288000
# INTERVIEW_MAX_VIDEO_SECONDS=1200
# Local English ASR. First use downloads the selected model.
# INTERVIEW_ASR_MODEL=small.en
# CPU int8 is the safest Windows default. Use cuda only after CUDA/cuDNN are configured.
# INTERVIEW_ASR_DEVICE=cpu
# INTERVIEW_ASR_COMPUTE_TYPE=int8
# INTERVIEW_ASR_DOWNLOAD_ROOT=./.cache/whisper-models
# Conservative character budget for every DeepSeek interview prompt.
# INTERVIEW_LLM_INPUT_CHAR_BUDGET=24000
# INTERVIEW_LLM_MAX_OUTPUT_TOKENS=4096
# INTERVIEW_ANALYSIS_WORKERS=2
