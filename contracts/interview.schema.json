{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vr200707/AIE1903/contracts/interview.schema.json",
  "title": "AIE1903 Interview Workflow Contract",
  "description": "English interview question sets and timestamped analysis reports. Question sets are generated from an existing candidate profile; report statements are grounded in transcript segment IDs.",
  "oneOf": [
    { "$ref": "#/$defs/QuestionSet" },
    { "$ref": "#/$defs/InterviewReport" }
  ],
  "$defs": {
    "Confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "EvidenceStatus": {
      "type": "string",
      "enum": ["confirmed", "not_found_public", "to_verify", "conflict"]
    },
    "Competency": {
      "type": "string",
      "enum": [
        "research_impact",
        "ownership_leadership",
        "evidence_clarity",
        "teaching",
        "collaboration",
        "career_motivation",
        "other"
      ]
    },
    "AnalysisWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "message", "retryable", "source"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "source": { "type": ["string", "null"] }
      }
    },
    "QuestionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "source_url",
        "excerpt",
        "evidence_status",
        "page",
        "source_type",
        "profile_path"
      ],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "source_url": { "type": ["string", "null"], "format": "uri" },
        "excerpt": { "type": "string" },
        "evidence_status": { "$ref": "#/$defs/EvidenceStatus" },
        "page": { "type": ["integer", "null"], "minimum": 1 },
        "source_type": { "type": ["string", "null"] },
        "profile_path": { "type": "string", "minLength": 1 }
      }
    },
    "SourceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "profile_path",
        "category",
        "claim",
        "evidence_statuses",
        "evidence"
      ],
      "properties": {
        "claim_id": { "type": "string", "pattern": "^C[0-9]+$" },
        "profile_path": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": [
            "publication",
            "funding",
            "award",
            "employment",
            "education",
            "service",
            "verification",
            "other"
          ]
        },
        "claim": { "type": "string", "minLength": 1 },
        "evidence_statuses": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceStatus" },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/QuestionEvidence" }
        }
      }
    },
    "Question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "order",
        "text",
        "competency",
        "objective",
        "why_it_matters",
        "answer_seconds",
        "approved",
        "source_claims"
      ],
      "properties": {
        "question_id": { "type": "string", "pattern": "^q_[0-9]{2}$" },
        "order": { "type": "integer", "minimum": 1, "maximum": 12 },
        "text": { "type": "string", "minLength": 1 },
        "competency": { "$ref": "#/$defs/Competency" },
        "objective": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "approved": { "type": "boolean" },
        "answer_seconds": {
          "type": "integer",
          "minimum": 45,
          "maximum": 180
        },
        "source_claims": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/$defs/SourceClaim" }
        }
      }
    },
    "QuestionGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "requested_question_count",
        "claim_candidates",
        "claims_sent_to_model",
        "input_char_budget",
        "source_truncated"
      ],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "requested_question_count": {
          "type": "integer",
          "minimum": 5,
          "maximum": 7
        },
        "claim_candidates": { "type": "integer", "minimum": 0 },
        "claims_sent_to_model": { "type": "integer", "minimum": 0 },
        "input_char_budget": { "type": "integer", "minimum": 6000 },
        "source_truncated": { "type": "boolean" }
      }
    },
    "QuestionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "question_set_id",
        "profile_id",
        "status",
        "language",
        "role_context",
        "candidate_name",
        "questions",
        "generation",
        "warnings",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "question_set_id": { "type": "string", "pattern": "^qset_" },
        "profile_id": { "type": "string", "pattern": "^prf_" },
        "status": { "enum": ["draft", "published"] },
        "candidate_token": { "type": ["string", "null"] },
        "language": { "const": "en" },
        "role_context": { "type": ["string", "null"] },
        "candidate_name": { "type": ["string", "null"] },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/Question" }
        },
        "generation": { "$ref": "#/$defs/QuestionGeneration" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/AnalysisWarning" }
        },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "Video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "content_type",
        "size_bytes",
        "sha256",
        "duration_ms",
        "width",
        "height"
      ],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "content_type": { "type": "string", "pattern": "^video/" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "TranscriptSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "start_ms", "end_ms", "text"],
      "properties": {
        "segment_id": { "type": "string", "pattern": "^s[0-9]{5}$" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "avg_logprob": { "type": ["number", "null"] },
        "no_speech_prob": { "type": ["number", "null"] },
        "uncertain": { "type": "boolean" }
      }
    },
    "AnswerWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms"],
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "GroundedQuestionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "supporting_segments"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "supporting_segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/TranscriptSegment" }
        }
      }
    },
    "QuestionScores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_specificity",
        "ownership",
        "depth",
        "consistency",
        "communication"
      ],
      "properties": {
        "evidence_specificity": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "ownership": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "depth": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "consistency": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "communication": { "type": ["number", "null"], "minimum": 0, "maximum": 10 }
      }
    },
    "QuestionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "order",
        "question",
        "competency",
        "answer_window",
        "alignment_confidence",
        "answered",
        "transcript_segments",
        "summary",
        "scores",
        "score_overall",
        "strengths",
        "concerns",
        "missing_details",
        "confidence"
      ],
      "properties": {
        "question_id": { "type": "string", "pattern": "^q_[0-9]{2}$" },
        "order": { "type": "integer", "minimum": 1, "maximum": 7 },
        "question": { "type": "string", "minLength": 1 },
        "competency": { "$ref": "#/$defs/Competency" },
        "answer_window": {
          "anyOf": [
            { "$ref": "#/$defs/AnswerWindow" },
            { "type": "null" }
          ]
        },
        "alignment_confidence": { "$ref": "#/$defs/Confidence" },
        "answered": { "type": "boolean" },
        "transcript_segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/TranscriptSegment" }
        },
        "summary": { "type": "string" },
        "scores": { "$ref": "#/$defs/QuestionScores" },
        "score_overall": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 10
        },
        "strengths": {
          "type": "array",
          "items": { "$ref": "#/$defs/GroundedQuestionItem" }
        },
        "concerns": {
          "type": "array",
          "items": { "$ref": "#/$defs/GroundedQuestionItem" }
        },
        "missing_details": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "$ref": "#/$defs/Confidence" }
      }
    },
    "GroundedOverallItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "question_ids", "supporting_segments"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "question_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^q_[0-9]{2}$" }
        },
        "supporting_segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/TranscriptSegment" }
        }
      }
    },
    "OverallReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "strengths",
        "risks",
        "recommended_follow_up_questions"
      ],
      "properties": {
        "summary": { "type": "string" },
        "strengths": {
          "type": "array",
          "items": { "$ref": "#/$defs/GroundedOverallItem" }
        },
        "risks": {
          "type": "array",
          "items": { "$ref": "#/$defs/GroundedOverallItem" }
        },
        "recommended_follow_up_questions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "TimestampInventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "order",
        "answered",
        "start_ms",
        "end_ms",
        "alignment_confidence",
        "segment_ids",
        "profile_paths"
      ],
      "properties": {
        "question_id": { "type": "string", "pattern": "^q_[0-9]{2}$" },
        "order": { "type": "integer", "minimum": 1, "maximum": 7 },
        "answered": { "type": "boolean" },
        "start_ms": { "type": ["integer", "null"], "minimum": 0 },
        "end_ms": { "type": ["integer", "null"], "minimum": 1 },
        "alignment_confidence": { "$ref": "#/$defs/Confidence" },
        "segment_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^s[0-9]{5}$" }
        },
        "profile_paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "CommunicationMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word_count",
        "speech_duration_ms",
        "speech_ratio",
        "articulation_rate_wpm",
        "overall_speech_rate_wpm",
        "long_pause_count",
        "longest_pause_ms",
        "filler_count",
        "filler_rate_per_100_words",
        "mean_volume_dbfs",
        "volume_variability_db",
        "answered_questions",
        "question_count",
        "coverage_ratio"
      ],
      "properties": {
        "word_count": { "type": "integer", "minimum": 0 },
        "speech_duration_ms": { "type": "integer", "minimum": 0 },
        "speech_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "articulation_rate_wpm": { "type": ["number", "null"], "minimum": 0 },
        "overall_speech_rate_wpm": { "type": ["number", "null"], "minimum": 0 },
        "long_pause_count": { "type": "integer", "minimum": 0 },
        "longest_pause_ms": { "type": "integer", "minimum": 0 },
        "filler_count": { "type": "integer", "minimum": 0 },
        "filler_rate_per_100_words": { "type": "number", "minimum": 0 },
        "mean_volume_dbfs": { "type": ["number", "null"] },
        "volume_variability_db": { "type": ["number", "null"], "minimum": 0 },
        "answered_questions": { "type": "integer", "minimum": 0 },
        "question_count": { "type": "integer", "minimum": 0 },
        "coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "CommunicationInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "level", "observation", "confidence"],
      "properties": {
        "dimension": { "type": "string", "minLength": 1 },
        "level": { "type": "string", "minLength": 1 },
        "observation": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/Confidence" }
      }
    },
    "CommunicationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "interpretations", "caveats"],
      "properties": {
        "metrics": { "$ref": "#/$defs/CommunicationMetrics" },
        "interpretations": {
          "type": "array",
          "items": { "$ref": "#/$defs/CommunicationInterpretation" }
        },
        "caveats": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "InterviewReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "interview_id",
        "question_set_id",
        "language",
        "analysis_model",
        "generated_at",
        "video",
        "overall_report",
        "question_results",
        "timestamp_inventory",
        "communication_profile",
        "warnings"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "interview_id": { "type": "string", "pattern": "^int_" },
        "question_set_id": { "type": "string", "pattern": "^qset_" },
        "language": { "const": "en" },
        "analysis_model": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "video": { "$ref": "#/$defs/Video" },
        "overall_report": { "$ref": "#/$defs/OverallReport" },
        "question_results": {
          "type": "array",
          "minItems": 5,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/QuestionResult" }
        },
        "timestamp_inventory": {
          "type": "array",
          "minItems": 5,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/TimestampInventoryItem" }
        },
        "communication_profile": { "$ref": "#/$defs/CommunicationProfile" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/AnalysisWarning" }
        }
      }
    }
  }
}
